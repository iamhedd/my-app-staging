# Runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=1
STATIC_DIR=../dist
LOG_LEVEL=info

# PostgreSQL (Hamravesh connection string; never expose this to Vite/browser)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Google Cloud OAuth Web Application credentials
ENABLE_GOOGLE_AUTH=true
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Optional migration location override
MIGRATIONS_DIR=../postgres/migrations
